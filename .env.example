# Server Configuration
PORT=4000

# Database
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Security / JWT
JWT_SECRET=change-me

# Initial Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Configuration (Nodemailer / Gmail App Password)
EMAIL_USER=
EMAIL_PASS=

# Phone OTP Verification
# Leave SMS_PROVIDER empty/log to print the code to the server console (dev).
SMS_PROVIDER=
SMS_FROM_NAME=
OTP_EXPIRY_SECONDS=300
OTP_COOLDOWN_SECONDS=120
OTP_MAX_ATTEMPTS=5

# Mobile Money (MoMo / Airtel) Gateway
MOMO_PRIMARY_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_BASE_URL=
MOMO_TARGET_ENV=
MOMO_WEBHOOK_SECRET=
AIRTEL_WEBHOOK_SECRET=